# =================================
# AIRC Auth Service - Environment Variables
# =================================

# Application
APP_NAME="AIRC Auth Service"
DEBUG=True

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=airc_auth_db

# JWT Configuration (must match Core Service)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
